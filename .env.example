# Model provider: "gemini" (default, free key from https://aistudio.google.com/apikey)
# or "openai" (https://platform.openai.com/api-keys). See core/llm.py.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional overrides; defaults: gemini-3.5-flash / gpt-4o-mini
LLM_MODEL=
# Optional: embeddings (fraud-case search only) default to LLM_PROVIDER's provider.
# Defaults: models/gemini-embedding-001 / text-embedding-3-small. See core/embeddings.py.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

CHECKPOINT_DB_PATH=checkpoints.sqlite
MEMORY_DB_PATH=account_memory.sqlite
# Defaults to true: every process start wipes account memory, so repeated
# testing never accumulates enough history to skew triage. Set to false only
# to demo memory persisting across separate CLI invocations (each CLI command
# is its own process, so this would otherwise wipe memory before every command).
RESET_MEMORY_ON_START=true

# Optional: LangSmith run tracing (LLM calls, timings, inputs/outputs).
# Off by default - requires a free LangSmith account. Set LANGSMITH_TRACING=true
# and fill in LANGSMITH_API_KEY to enable; picked up automatically by
# LangChain/LangGraph, no code changes needed. Separate from LangGraph Studio,
# which works with `langgraph dev` regardless of these being set.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=fraud-guard


